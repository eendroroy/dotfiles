{
  "font_family": "JetBrainsMono Nerd Font Mono",
  "font_fallbacks": [
    "Menlo",
    "Hasklug Nerd Font Mono",
    "Maple Mono NF CN",
    "PingFang SC",
    "Apple Color Emoji"
  ],
  "font_family_bold": null,
  "font_family_italic": null,
  "font_features": null,
  "font_thicken": true,
  "font_size": 16.0,
  "line_height": 1.67,
  "ui_font_size": 16.0,
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "theme": "dark",
  "theme_preset": "dark",
  "theme_follow_system": true,
  "theme_preset_light": "light",
  "theme_preset_dark": "e_ink_dark",
  "theme_legible_palette": true,
  "window_opacity": null,
  "window_blur": null,
  "window_backdrop": "auto",
  "dim_inactive_panes": true,
  "keybindings": {},
  "keybinding_preset": "default",
  "prefix": "ctrl-b",
  "shell": null,
  "custom_shells": [],
  "link_url": true,
  "link_file_open": "internal",
  "link_file_command": null,
  "ssh_loopback_forward": true,
  "cursor_blink": true,
  "scrollback_limit": 10000,
  "new_tab_position": "after-current",
  "tab_bar_position": "left",
  "sidebar_width": 190.84375,
  "sidebar_collapsed": false,
  "right_panel_visible": false,
  "right_panel_width": 260.0,
  "right_panel_tab": "info",
  "diff_view": "split",
  "document_layout": "dock",
  "document_ratio": 0.5,
  "scm_graph_expanded": false,
  "scm_changes_tree": false,
  "editor_soft_wrap": false,
  "editor_markdown_preview": false,
  "editor_lsp": true,
  "editor_git_gutter": true,
  "sidebar_auto_grouping": true,
  "notify_on_command_finish": "unfocused",
  "check_for_updates": true,
  "update_channel": "stable",
  "auto_download_updates": true,
  "install_cli_on_path": true,
  "gui_language": "en",
  "notify_threshold_secs": 10,
  "restore_session": true,
  "show_tray_icon": false,
  "bell": "visual",
  "prompt_editor": true,
  "tab_completion": true,
  "history_search": true,
  "cursor_style": "block",
  "prompt_cursor_style": "follow",
  "macos_option_as_alt": false,
  "mouse_hide_while_typing": true,
  "focus_follows_mouse": false,
  "mouse_scroll_multiplier": 1.0,
  "smooth_scroll": true,
  "mouse_reporting": true,
  "mouse_zoom_modifier": "platform",
  "clipboard_trim_trailing_spaces": false,
  "copy_on_select": false,
  "http_proxy": null,
  "smart_select": true,
  "word_separators": ",│`|:\"' ()[]{}<>\t",
  "startup_mode": "normal",
  "remember_window_size": true,
  "working_directory": {
    "strategy": "inherit",
    "path": ""
  },
  "env": {},
  "verify_host_keys": true,
  "ssh_warn_on_close": false,
  "shell_frecency": {},
